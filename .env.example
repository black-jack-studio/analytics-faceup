# --- Supabase (read-only) ---
# Use the anon key ONLY if RLS policies restrict it to read-only, safe-to-expose data.
# This app never writes to Supabase — see src/lib/supabase/client.ts.
VITE_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
VITE_SUPABASE_ANON_KEY=eyJxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# --- PostHog ---
# Project/API key used client-side for capturing (not required for the dashboard itself).
VITE_POSTHOG_KEY=phc_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
VITE_POSTHOG_HOST=https://eu.i.posthog.com

# Personal/Project API key with read access, used to query the PostHog HogQL/Query API
# from the dashboard (funnels, breakdowns, trends). Keep this out of client bundles in
# production — see README "Securing the PostHog Query API" section.
VITE_POSTHOG_PROJECT_ID=00000
VITE_POSTHOG_PERSONAL_API_KEY=phx_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
